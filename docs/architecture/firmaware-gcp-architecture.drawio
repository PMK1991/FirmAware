<mxfile host="app.diagrams.net" type="device" version="24.7.17">
  <diagram id="firmaware-runtime" name="1 · Runtime architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="r0" />
        <mxCell id="r1" parent="r0" />

        <mxCell id="rTitle" value="FirmAware — GCP runtime architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#202124;" vertex="1" parent="r1">
          <mxGeometry x="40" y="18" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="rSub" value="project firmaware · region us-central1 · env dev · every resource inside the boundary is provisioned by Terraform in infra/" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6368;" vertex="1" parent="r1">
          <mxGeometry x="40" y="50" width="1400" height="22" as="geometry" />
        </mxCell>

        <mxCell id="rGcp" value="Google Cloud — project firmaware (us-central1)" style="rounded=1;html=1;dashed=1;dashPattern=8 6;strokeWidth=2;strokeColor=#4285F4;fillColor=none;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#174EA6;" vertex="1" parent="r1">
          <mxGeometry x="300" y="95" width="1420" height="780" as="geometry" />
        </mxCell>

        <mxCell id="rSched" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;firmaware-dev-nightly-predict&lt;br&gt;0 2 * * *  (Etc/UTC) · ENABLED&lt;br&gt;retries 0 · deadline 600s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#B06000;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="340" y="140" width="320" height="105" as="geometry" />
        </mxCell>

        <mxCell id="rReg" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;firmaware (DOCKER)&lt;br&gt;immutable tags · jobs are pinned&lt;br&gt;to an image digest, never a tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=12;fontColor=#6A1B9A;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="1330" y="140" width="370" height="105" as="geometry" />
        </mxCell>

        <mxCell id="rJobs" value="Cloud Run Jobs — runtime identity  sa-firmaware-jobs" style="rounded=1;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#174EA6;" vertex="1" parent="r1">
          <mxGeometry x="340" y="300" width="890" height="250" as="geometry" />
        </mxCell>
        <mxCell id="rJobValidate" value="&lt;b&gt;validate&lt;/b&gt;&lt;br&gt;1 vCPU · 2 GiB&lt;br&gt;timeout 600s · retries 1&lt;br&gt;&lt;br&gt;Enforces the data contract&lt;br&gt;before anything is trusted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="360" y="355" width="270" height="165" as="geometry" />
        </mxCell>
        <mxCell id="rJobTrain" value="&lt;b&gt;train&lt;/b&gt;&lt;br&gt;4 vCPU · 8 GiB&lt;br&gt;timeout 1800s · retries 0&lt;br&gt;&lt;br&gt;Tunes, evaluates and promotes&lt;br&gt;the champion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="650" y="355" width="270" height="165" as="geometry" />
        </mxCell>
        <mxCell id="rJobPredict" value="&lt;b&gt;predict&lt;/b&gt;&lt;br&gt;1 vCPU · 2 GiB&lt;br&gt;timeout 600s · retries 1&lt;br&gt;&lt;br&gt;Scores upcoming deployments&lt;br&gt;against the champion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="940" y="355" width="270" height="165" as="geometry" />
        </mxCell>

        <mxCell id="rStore" value="Cloud Storage — uniform bucket-level access, least privilege per bucket" style="rounded=1;html=1;fillColor=#E6F4EA;strokeColor=#34A853;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0D652D;" vertex="1" parent="r1">
          <mxGeometry x="340" y="610" width="890" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rBData" value="&lt;b&gt;firmaware-dev-data&lt;/b&gt;&lt;br&gt;versioned · 90d noncurrent&lt;br&gt;jobs: objectViewer&lt;br&gt;&lt;br&gt;deployment_events.csv&lt;br&gt;upcoming_deployments.csv&lt;br&gt;smoke/upcoming_smoke.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="360" y="662" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rBArt" value="&lt;b&gt;firmaware-dev-artifacts&lt;/b&gt;&lt;br&gt;versioned · 90d noncurrent&lt;br&gt;jobs: objectAdmin&lt;br&gt;&lt;br&gt;model · preprocessor · metadata&lt;br&gt;champion.json&lt;br&gt;deployments/live.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="650" y="662" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rBScores" value="&lt;b&gt;firmaware-dev-scores&lt;/b&gt;&lt;br&gt;not versioned&lt;br&gt;jobs: objectCreator + objectViewer&lt;br&gt;&lt;i&gt;no delete permission → append-only&lt;/i&gt;&lt;br&gt;&lt;br&gt;scores/scores_&amp;lt;ts&amp;gt;_&amp;lt;run&amp;gt;.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="940" y="662" width="270" height="150" as="geometry" />
        </mxCell>
        <mxCell id="rNote" value="A fourth bucket, firmaware-…-tf-state, holds Terraform state. It is deploy-time only — the jobs have no access to it. See page 2." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#5F6368;" vertex="1" parent="r1">
          <mxGeometry x="360" y="842" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="rObs" value="Cloud Logging &amp;amp; Cloud Monitoring" style="rounded=1;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#B31412;" vertex="1" parent="r1">
          <mxGeometry x="1330" y="300" width="370" height="530" as="geometry" />
        </mxCell>
        <mxCell id="rLog" value="&lt;b&gt;Log-based metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;job_failure&lt;br&gt;contract_violation&lt;br&gt;smoke_contract_violation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="1350" y="355" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="rAlert" value="&lt;b&gt;Alert policy&lt;/b&gt;&lt;br&gt;&lt;br&gt;4 conditions, OR-combined&lt;br&gt;auto-close after 30m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="1350" y="530" width="330" height="105" as="geometry" />
        </mxCell>
        <mxCell id="rMail" value="&lt;b&gt;Email notification channel&lt;/b&gt;&lt;br&gt;on-call owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA4335;fontSize=11;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="1350" y="690" width="330" height="85" as="geometry" />
        </mxCell>

        <mxCell id="rSrc" value="&lt;b&gt;Data source / operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Uploads the two contract CSVs&lt;br&gt;deployment_events.csv&lt;br&gt;upcoming_deployments.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="40" y="662" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="rApp" value="&lt;b&gt;Streamlit predictions page&lt;/b&gt; — app.py, runs outside GCP&lt;br&gt;&lt;br&gt;FIRMAWARE_SCORES_URI · FIRMAWARE_ARTIFACTS_URI · FIRMAWARE_DATA_URI&lt;br&gt;&lt;br&gt;Reads the newest score object and the champion threshold, then renders the&lt;br&gt;fleet overview and the deployment inspector. Never trains, scores or writes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="r1">
          <mxGeometry x="795" y="920" width="560" height="130" as="geometry" />
        </mxCell>

        <mxCell id="rE1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#F9AB00;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rSched" target="rJobPredict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rE1L" value="OAuth POST  jobs:run&#10;sa-firmaware-scheduler holds run.invoker&#10;on the predict job only" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#B06000;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rE1">
          <mxGeometry x="-0.35" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <mxCell id="rE2" value="image digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#A142F4;fontSize=11;fontColor=#6A1B9A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.2;verticalAlign=bottom;" edge="1" parent="r1" source="rReg" target="rJobs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rE3" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5F6368;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="r1" source="rSrc" target="rBData">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rE4" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#34A853;fontSize=11;fontColor=#0D652D;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rJobValidate" target="rBData">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rE5" value="write model + champion.json" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#34A853;fontSize=11;fontColor=#0D652D;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rJobTrain" target="rBArt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rE6" value="append one immutable&#10;score object per run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#34A853;fontSize=11;fontColor=#0D652D;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rJobPredict" target="rBScores">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rE7" value="read-only&#10;newest scores + champion threshold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5F6368;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=0.5;exitY=0;entryX=0.83;entryY=1;" edge="1" parent="r1" source="rApp" target="rStore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rE8" value="logs ·&#10;exit codes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA4335;fontSize=11;fontColor=#B31412;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.236;" edge="1" parent="r1" source="rJobs" target="rObs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rE9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA4335;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rLog" target="rAlert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rE10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#EA4335;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="r1" source="rAlert" target="rMail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="firmaware-cicd" name="2 · CI/CD and progressive delivery">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="cTitle" value="FirmAware — CI/CD and progressive delivery to GCP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#202124;" vertex="1" parent="c1">
          <mxGeometry x="40" y="18" width="1000" height="32" as="geometry" />
        </mxCell>
        <mxCell id="cSub" value="Keyless GitHub → GCP auth, then a candidate is proven against real data before the nightly schedule is allowed to resume" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6368;" vertex="1" parent="c1">
          <mxGeometry x="40" y="50" width="1200" height="22" as="geometry" />
        </mxCell>

        <mxCell id="cGh" value="GitHub — PMK1991/FirmAware" style="rounded=1;html=1;fillColor=#F1F3F4;strokeColor=#5F6368;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#202124;" vertex="1" parent="c1">
          <mxGeometry x="40" y="100" width="400" height="440" as="geometry" />
        </mxCell>
        <mxCell id="cPush" value="&lt;b&gt;Pull request / push to main&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="145" width="360" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cCi" value="&lt;b&gt;CI workflow&lt;/b&gt; — ci.yaml&lt;br&gt;python: ruff check src tests · pytest&lt;br&gt;container: docker build&lt;br&gt;terraform: fmt · validate · tflint&lt;br&gt;&lt;i&gt;all dependencies pinned exactly&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="225" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cCd" value="&lt;b&gt;Deploy dev workflow&lt;/b&gt; — deploy-dev.yaml&lt;br&gt;trigger: workflow_run after CI succeeds on main&lt;br&gt;environment: development&lt;br&gt;concurrency group firmaware-dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="385" width="360" height="130" as="geometry" />
        </mxCell>

        <mxCell id="cWif" value="&lt;b&gt;Workload Identity Federation&lt;/b&gt;&lt;br&gt;issuer token.actions.githubusercontent.com&lt;br&gt;&lt;br&gt;attribute condition (dev):&lt;br&gt;repository == PMK1991/FirmAware&lt;br&gt;&amp;amp;&amp;amp; environment == development&lt;br&gt;&amp;amp;&amp;amp; ref == refs/heads/main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#174EA6;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="500" y="180" width="380" height="175" as="geometry" />
        </mxCell>
        <mxCell id="cSa" value="&lt;b&gt;sa-firmaware-deployer&lt;/b&gt;&lt;br&gt;keyless — no JSON key ever issued&lt;br&gt;&lt;br&gt;run.admin · storage.admin · artifactregistry.admin&lt;br&gt;cloudscheduler.admin · iam + monitoring + logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#174EA6;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="500" y="400" width="380" height="140" as="geometry" />
        </mxCell>
        <mxCell id="cState" value="&lt;b&gt;Terraform backend&lt;/b&gt;&lt;br&gt;gs://firmaware-558685262335-tf-state&lt;br&gt;prefix firmaware/dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="500" y="590" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cProd" value="&lt;b&gt;Production path — not yet provisioned&lt;/b&gt;&lt;br&gt;deploy-prod.yaml · environment production&lt;br&gt;WIF condition requires ref refs/tags/v*&lt;br&gt;deletion_protection on jobs, PREVENT on buckets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;fontSize=12;fontColor=#5F6368;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="500" y="720" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="cNotes" value="&lt;b&gt;What this pipeline guarantees&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; The deploy workflow refuses to run against anything but the exact commit CI already verified on main.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; No long-lived credential exists. Workload Identity Federation mints a short-lived token per run and no service-account JSON key is ever issued.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; Jobs reference an image &lt;i&gt;digest&lt;/i&gt;, and the registry uses immutable tags, so a re-tag cannot silently change what runs.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; The nightly scheduler is paused for the whole deploy window, so a half-applied candidate can never be invoked.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; A candidate is proven against real deployment data before it is activated, not just built.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; Rollback restores the previous digest and &lt;i&gt;then&lt;/i&gt; fails the workflow, so a bad deploy is never reported green.&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; Production promotes the same digest that passed dev. It is never rebuilt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DADCE0;fontSize=11;fontColor=#3C4043;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="c1">
          <mxGeometry x="40" y="580" width="400" height="330" as="geometry" />
        </mxCell>
        <mxCell id="cFiles" value="&lt;b&gt;Where this lives in the repo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; .github/workflows/ci.yaml&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; .github/workflows/deploy-dev.yaml&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; deploy/build.sh · deploy/smoke_test.sh · deploy/rollback_image.sh&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; infra/ — root module plus modules/foundation, storage, iam, jobs&lt;br&gt;&lt;b&gt;·&lt;/b&gt;&amp;nbsp; infra/envs/dev.tfvars — the dev variable values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DADCE0;fontSize=11;fontColor=#3C4043;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=8;" vertex="1" parent="c1">
          <mxGeometry x="40" y="930" width="400" height="180" as="geometry" />
        </mxCell>

        <mxCell id="cSeq" value="Deployment sequence — every step runs against the deploy SHA" style="rounded=1;html=1;fillColor=none;strokeColor=#4285F4;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#174EA6;" vertex="1" parent="c1">
          <mxGeometry x="940" y="100" width="620" height="1010" as="geometry" />
        </mxCell>

        <mxCell id="cS1" value="&lt;b&gt;1 · Guard&lt;/b&gt;  refuse a stale or non-main SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#B06000;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="965" y="145" width="570" height="52" as="geometry" />
        </mxCell>
        <mxCell id="cS2" value="&lt;b&gt;2 · Re-run&lt;/b&gt;  ruff + pytest at that exact SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="965" y="217" width="570" height="52" as="geometry" />
        </mxCell>
        <mxCell id="cS3" value="&lt;b&gt;3 · Re-check infrastructure&lt;/b&gt;  terraform fmt · validate · tflint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="965" y="289" width="570" height="52" as="geometry" />
        </mxCell>

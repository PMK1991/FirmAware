  <diagram id="firmaware-cicd" name="2 · CI/CD and progressive delivery">
    <mxGraphModel dx="1500" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="930" math="0" shadow="0">
      <root>
        <mxCell id="c0" />
        <mxCell id="c1" parent="c0" />

        <mxCell id="cTitle" value="FirmAware — CI/CD and progressive delivery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#202124;" vertex="1" parent="c1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cSub" value="Keyless GitHub → GCP auth, then a candidate is proven against real data before the nightly schedule resumes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#5F6368;" vertex="1" parent="c1">
          <mxGeometry x="40" y="50" width="1200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cGh" value="GitHub — PMK1991/FirmAware" style="rounded=1;html=1;fillColor=#F1F3F4;strokeColor=#202124;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#202124;" vertex="1" parent="c1">
          <mxGeometry x="40" y="95" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="cPush" value="&lt;b&gt;Pull request / push to main&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="135" width="340" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cCi" value="&lt;b&gt;CI workflow&lt;/b&gt; — ci.yaml&lt;br&gt;&lt;br&gt;ruff · pytest · docker build&lt;br&gt;terraform fmt · validate · tflint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="210" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cCd" value="&lt;b&gt;Deploy dev workflow&lt;/b&gt;&lt;br&gt;deploy-dev.yaml · after CI passes on main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="60" y="340" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="cNotes" value="&lt;b&gt;Why this is safe&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Deploys only the exact commit CI verified on main.&lt;br&gt;· No stored credential — WIF mints a short-lived token.&lt;br&gt;· Jobs run an immutable digest, never a tag.&lt;br&gt;· The scheduler stays paused until the candidate passes.&lt;br&gt;· Rollback restores the previous digest, then fails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#DADCE0;fontSize=11;fontColor=#3C4043;verticalAlign=top;align=left;spacingLeft=12;spacingRight=12;spacingTop=10;" vertex="1" parent="c1">
          <mxGeometry x="40" y="480" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="cWif" value="&lt;b&gt;Workload Identity Federation&lt;/b&gt;&lt;br&gt;token.actions.githubusercontent.com&lt;br&gt;&lt;br&gt;repo == PMK1991/FirmAware&lt;br&gt;env == development · ref == main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#174EA6;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="470" y="150" width="340" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cSa" value="&lt;b&gt;sa-firmaware-deployer&lt;/b&gt;&lt;br&gt;keyless — no JSON key issued&lt;br&gt;&lt;br&gt;run · storage · artifactregistry&lt;br&gt;cloudscheduler · iam · monitoring" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=11;fontColor=#174EA6;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="470" y="330" width="340" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cState" value="&lt;b&gt;Terraform backend&lt;/b&gt;&lt;br&gt;gs://firmaware-…-tf-state · firmaware/dev" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;fontSize=11;fontColor=#3C4043;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="470" y="495" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cProd" value="&lt;b&gt;Production path&lt;/b&gt; — not provisioned&lt;br&gt;&lt;br&gt;deploy-prod.yaml · ref refs/tags/v*&lt;br&gt;deletion_protection · PREVENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0A6;dashed=1;fontSize=11;fontColor=#5F6368;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="470" y="660" width="340" height="95" as="geometry" />
        </mxCell>

        <mxCell id="cSeq" value="Deployment sequence — every step runs against the deploy SHA" style="rounded=1;html=1;fillColor=none;strokeColor=#4285F4;strokeWidth=2;dashed=1;dashPattern=8 6;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#174EA6;" vertex="1" parent="c1">
          <mxGeometry x="860" y="95" width="600" height="790" as="geometry" />
        </mxCell>
        <mxCell id="cS1" value="&lt;b&gt;1 · Guard&lt;/b&gt;  refuse a stale or non-main SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="140" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS2" value="&lt;b&gt;2 · Re-run&lt;/b&gt;  ruff + pytest at that SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="200" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS3" value="&lt;b&gt;3 · Re-check infra&lt;/b&gt;  terraform fmt · validate · tflint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5F6368;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="260" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS4" value="&lt;b&gt;4 · Build&lt;/b&gt;  push the image, resolve to a digest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FD;strokeColor=#A142F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="320" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS5" value="&lt;b&gt;5 · Pause&lt;/b&gt;  the nightly scheduler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="380" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS6" value="&lt;b&gt;6 · Apply candidate&lt;/b&gt;  terraform apply, scheduler_enabled = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="440" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS7" value="&lt;b&gt;7 · Validate&lt;/b&gt;  run the validate job on real data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="500" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cS8" value="&lt;b&gt;8 · Smoke test&lt;/b&gt;  score the 5-row fixture end to end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;fontColor=#202124;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="560" width="550" height="42" as="geometry" />
        </mxCell>
        <mxCell id="cGate" value="&lt;b&gt;Both passed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202124;fontSize=12;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="1075" y="640" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cFail" value="&lt;b&gt;Roll back&lt;/b&gt;&lt;br&gt;&lt;br&gt;restore the previous digest,&lt;br&gt;then fail the workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;fontSize=11;fontColor=#B31412;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="885" y="750" width="260" height="105" as="geometry" />
        </mxCell>
        <mxCell id="cPass" value="&lt;b&gt;Activate&lt;/b&gt;&lt;br&gt;&lt;br&gt;scheduler_enabled = true&lt;br&gt;nightly schedule resumes&lt;br&gt;write deployments/live.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;fontSize=11;fontColor=#0D652D;verticalAlign=middle;" vertex="1" parent="c1">
          <mxGeometry x="1175" y="750" width="260" height="105" as="geometry" />
        </mxCell>

        <mxCell id="cE1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5F6368;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="c1" source="cPush" target="cCi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cE2" value="on success (main)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#5F6368;fontSize=11;labelBackgroundColor=#F1F3F4;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="c1" source="cCi" target="cCd">
